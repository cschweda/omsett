# What omsett.com is set up to do beyond converting. scripts/publish-static.sh reads this when
# it builds the site for the server; nothing else does, so the tests, the self-host image and a
# plain `pnpm build` are a copy of Omsett that does neither.
#
# Running your own copy from this repository? Change these to your own, or delete this file.
# A line in the server's own .env overrides the same line here.

# Count visits, with Plausible, under this site's name. Only pages served from that name are
# ever counted, so a copy somewhere else counts nothing.
OMSETT_VISITS_SITE=omsett.com

# Offer to check a document's accessibility with this checker. Nothing is sent to it unless a
# visitor asks, each time.
OMSETT_ACCESSIBILITY_CHECKER=https://audit.icjia.app

{
  "name": "omsett",
  "version": "0.32.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:lan": "pnpm --filter web dev:lan",
    "dev:lan:https": "pnpm --filter web dev:lan:https",
    "build": "pnpm --filter web generate && pnpm --filter web write-headers",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "security:docs": "node scripts/security-docs.ts",
    "tests:count": "node scripts/count-tests.ts",
    "readme:facts": "OMSETT_WRITE_README=1 vitest run scripts/readme-facts.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@omsett/detect": "workspace:*",
    "@omsett/engines": "workspace:*",
    "@omsett/registry": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}

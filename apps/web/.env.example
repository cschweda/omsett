# No .env file is committed. Nothing here is secret; these only label the build.

# Canonical URL for meta tags. Netlify.
NUXT_PUBLIC_SITE_URL=https://omsett.com

# Shown in the footer tooltip. On Netlify the build reads COMMIT_REF by itself.
NUXT_PUBLIC_COMMIT=dev

# Docker `web` container only (set in docker-compose.yml, not read by the Nuxt build):
# OMSETT_SITE_ADDRESS=:8080   Caddy's site address. A hostname turns on HTTPS, which any
#                             address other than localhost needs.
# OMSETT_SERVER=              Upstream omsettd for the /api/* proxy. Empty means no server,
#                             which is the normal state.

# Serves the static build with the same headers Netlify sends. The header set is generated by
# scripts/write-headers.ts from security-headers.ts; nothing about headers is written here.
#
# There is no entrypoint script and nothing is written at runtime. Two environment variables
# drive everything:
#   OMSETT_SITE_ADDRESS  the site address. ":8080" serves plain HTTP, which browsers treat as
#                        secure only on localhost. A hostname makes Caddy serve HTTPS, which
#                        any other address needs.
#   OMSETT_SERVER        upstream omsettd for /api/*. Empty means no server: the normal state.
{
	admin off
}

{$OMSETT_SITE_ADDRESS::8080} {
	root * /srv
	encode zstd gzip
	import headers.caddy

	# The app asks this one question about servers, of its own origin.
	handle /config.json {
		header Content-Type application/json
		header Cache-Control no-store
		@configured expression `"{$OMSETT_SERVER:}" != ""`
		handle @configured {
			respond `{"server":true}`
		}
		handle {
			respond `{"server":false}`
		}
	}

	# Same-origin proxy to omsettd (Phase 4). Without one, /api answers 404.
	handle_path /api/* {
		@configured expression `"{$OMSETT_SERVER:}" != ""`
		handle @configured {
			reverse_proxy {$OMSETT_SERVER:127.0.0.1:9}
		}
		handle {
			respond 404
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

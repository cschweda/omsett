    "@omsett/engines": "workspace:*",
    "@omsett/registry": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "comlink": "4.4.2",
    "decode-named-character-reference": "1.3.0",
    "mermaid": "^12.0.0",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
